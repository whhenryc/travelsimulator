{
  "name": "travel-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "sirv dist --host 0.0.0.0 --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "fetch:osm": "node scripts/fetch-osm.ts"
  },
  "dependencies": {
    "sirv-cli": "^3.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
